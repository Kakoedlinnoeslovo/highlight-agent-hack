# Live mode does not silently fall back to synthetic sample data.
HIGHLIGHT_MODE=live
HIGHLIGHT_DATA_DIR=data
HIGHLIGHT_OUTPUT_DIR=outputs
HIGHLIGHT_REQUEST_TIMEOUT=60

# Assigned VAST deployment, not the public VAST website.
VAST_BASE_URL=
# Optional original hostname when using the documented SSH tunnel.
VAST_HOST_HEADER=
# Use token OR username/password as supported by your assigned deployment.
VAST_ACCESS_TOKEN=
VAST_USERNAME=
VAST_PASSWORD=
# Needed if upload returns object_key without a complete s3:// URI.
VAST_UPLOAD_BUCKET=
# Optional configured hint. Confirm against actual segment model IDs and staff.
VAST_CAPTION_MODEL=

# W&B Inference and Weave; select a text model available to your account.
# The saved runs used meta-llama/Llama-3.3-70B-Instruct. The vision pass is fixed
# to google/gemma-4-31B-it in scripts/vision_tags.py.
WANDB_API_KEY=
WANDB_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
WANDB_MODEL=
WANDB_PROJECT=your-team/highlight-agent

# Local publishing only; also loaded from ignored web/.env.local when linked to Blob.
BLOB_READ_WRITE_TOKEN=
